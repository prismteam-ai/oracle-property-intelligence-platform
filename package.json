{
  "name": "oracle-property-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx --conditions=react-server src/db/migrate.ts",
    "db:seed": "tsx --conditions=react-server src/db/seed/load.ts",
    "db:embed": "tsx --conditions=react-server src/db/embed.ts",
    "db:embed:resume": "tsx --conditions=react-server src/db/resume-embed.ts",
    "ingest:parcels": "tsx scripts/ingest/parcels.ts",
    "ingest:load": "tsx scripts/ingest/run-bounded-load.ts",
    "db:setup": "pnpm db:push && pnpm db:seed && pnpm db:embed"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "^0.44.5",
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "undici": "^8.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
