# ============================================================================
# Oracle Property Intelligence Platform — environment template
# Copy to .env.local (git-ignored). NEVER prefix secrets with NEXT_PUBLIC_.
# ============================================================================

# --- THE SWAP SEAM -----------------------------------------------------------
# DATA_SOURCE selects the DataAccess provider in src/server/db.ts.
#   memory: DEFAULT — DB-free, in-process disclosed synthetic graph
#           (providers/memory.ts). No Postgres/docker/model/API key required, so
#           the exploration UI + RAG demo run (and are Playwright-drivable) on a
#           clean checkout. Used when DATA_SOURCE is unset outside production.
#           Never a silent production fallback: production fails loud unless
#           DATA_SOURCE is explicitly set (prod runs local/neon with DATABASE_URL).
#   local : local Postgres 16 + pgvector with the disclosed synthetic dataset
#           (providers/local.ts). Requires `pnpm db:setup`.
#   neon  : real @elephant-xyz/query-db on Neon (providers/neon.ts). Swap is
#           this one var + pointing DATABASE_URL at Neon (vercel env pull after
#           `vercel link --team elephant-xyz --project website`).
DATA_SOURCE=memory

# Postgres connection string (server-only). Local default below matches
# docker-compose.yml. For Neon, paste the pooled connection string.
DATABASE_URL=postgres://oracle:oracle@localhost:5432/oracle

# Transient cold-start retry for the local/neon Postgres data path. Neon auto-
# suspends (scale-to-zero); a query issued exactly during wake can fail once
# with a connection error. These bound a short jittered retry on TRANSIENT
# CONNECTION errors only (never on real SQL errors). Defaults shown.
DB_RETRY_MAX_ATTEMPTS=3
DB_RETRY_BASE_DELAY_MS=100
DB_RETRY_MAX_DELAY_MS=1000

# --- Deterministic synthetic generator --------------------------------------
# Fixed seed + base date => byte-identical rebuilds => stable UUIDs/deep links.
SEED=20260615
BASE_DATE=2026-06-15

# --- RAG embeddings (pluggable EmbeddingService port) ------------------------
# EMBEDDING_PROVIDER: openai | bedrock | local | stub
#   openai : DEFAULT — OpenAI text-embedding-3-small at 512 dimensions. This is
#            the model the real corpus is embedded with, so a fresh checkout
#            queries the live vectors over the same space. Real semantic vectors
#            for both the corpus embed pass and per-query embedding. FAIL-LOUD if
#            OPENAI_API_KEY is missing.
#   bedrock: AWS Bedrock Titan Text Embeddings v2 (amazon.titan-embed-text-v2:0,
#            1024-dim) via bearer-token auth. FAIL-LOUD if
#            AWS_BEARER_TOKEN_BEDROCK is missing.
#   local  : offline fastembed sidecar (BAAI/bge-small-en-v1.5).
#   stub   : deterministic, dependency-free lexical surrogate. The only default
#            under NODE_ENV=test, so unit tests run offline with no API key.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512
# URL of the local embeddings sidecar (only used when EMBEDDING_PROVIDER=local).
EMBEDDINGS_URL=http://localhost:8080

# OpenAI embeddings (EMBEDDING_PROVIDER=openai).
# OPENAI_API_KEY=                  # secret — set in .env.local / Vercel env
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=512

# AWS Bedrock (EMBEDDING_PROVIDER=bedrock). Bearer-token auth against the
# bedrock-runtime endpoint — no AWS SDK / SigV4 needed.
AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=        # secret — set in .env.local / Vercel env
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# BEDROCK_EMBED_DIM=1024           # optional override: 1024 (default) | 512 | 256

# --- RAG answer synthesis -----------------------------------------------------
# ANSWER_PROVIDER: bedrock | template
#   bedrock  : grounded synthesis with Bedrock Claude over the retrieved+cited
#              evidence (reuses AWS_BEARER_TOKEN_BEDROCK + AWS_REGION). FAIL-LOUD
#              if the token is missing. This is the runtime default.
#   template : deterministic templated synthesis (TEST/offline only; never a
#              silent runtime fallback).
ANSWER_PROVIDER=bedrock
ANSWER_MODEL=us.anthropic.claude-opus-4-6-v1
